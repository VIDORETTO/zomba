{
  "name": "zomba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n cliente,servidor -c yellow,cyan \"vite\" \"tsx watch src/server/main.ts\"",
    "dev:client": "vite",
    "server": "tsx src/server/main.ts",
    "servidor": "node servidor/iniciar.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.186.1",
    "trystero": "^0.26.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "node-turn": "^0.0.6",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
